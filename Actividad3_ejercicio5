print("Nombre: Camila Serna")
print("Matrícula: Al07013300")
print()

nombre_sistema = input("miraculous")

operaciones = 0

# El menú se repite siempre; la única salida es el break
while True:
    print()
    print("=====", nombre_sistema, "=====")
    print("1. Registrar nuevo juego (Altas)")
    print("2. Eliminar juego (Bajas)")
    print("3. Modificar datos de juego (Cambios)")
    print("4. Buscar juego en inventario (Consultas)")
    print("5. Imprimir reporte de stock")
    print("6. Salir")
    
    opcion = input("Elige una opción: ")

    if opcion == "1":
        print("➕ Aquí podrás registrar y dar de alta nuevos juegos en el inventario.")
        operaciones = operaciones + 1
    elif opcion == "2":
        print("🗑️ Aquí podrás eliminar juegos descatalogados de la base de datos.")
        operaciones = operaciones + 1
    elif opcion == "3":
        print("✏️ Aquí podrás actualizar precios, plataformas o stock de los juegos.")
        operaciones = operaciones + 1
    elif opcion == "4":
        print("🔍 Aquí podrás realizar búsquedas rápidas de juegos disponibles.")
        operaciones = operaciones + 1
    elif opcion == "5":
        print("🖨️ Aquí se generará el reporte imprimible del inventario total.")
        operaciones = operaciones + 1
    elif opcion == "6":
        # Antes de salir, confirmamos
        seguro = input("¿Seguro que quieres salir del sistema? (s/n): ")

        # ¿La respuesta es IGUAL a "s"?
        if seguro == "s":
            print("👋 Realizaste", operaciones, "operaciones en total. ¡Hasta luego, Uriel!")
            # break nos saca del while
            break
        else:
            print("👍 Regresando al menú principal...")
    else:
        # Opción inválida: no se cuenta como operación
        print("❌ Opción no válida, elige del 1 al 6")