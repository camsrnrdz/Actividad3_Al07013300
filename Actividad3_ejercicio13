# Creamos la lista con 4 juegos actualizados
juegos = ["Minecraft", "Roblox", "Mobile Legends", "Toca boca"]

# Casillero 1: el primero
print("🏅 Mi juego número 1:", juegos[0])

# Casillero -1: el último
print("🔚 El último de mi lista:", juegos[-1])

# Casillero 2: el tercero (porque empezamos en 0)
print("3️⃣ El tercero:", juegos[2])

# len() cuenta cuántos hay
print("📦 Tengo", len(juegos), "juegos favoritos")

# Mostramos la lista numerada
print()
print("===== MIS FAVORITOS DE Camila =====")
# range(len(juegos)) nos da los casilleros correspondientes
for i in range(len(juegos)):
    # Mostramos i + 1 para que la persona vea del 1 al 4
    print(i + 1, ".", juegos[i])

print()
# Pedimos un número del 1 al 4
numero = int(input("Escribe un número del 1 al 4: "))

# La persona cuenta desde 1, pero Python desde 0: por eso le restamos 1
print("🎮 Elegiste:", juegos[numero - 1])
print("¡Excelente elección de juego!")